# Canonical site URL used by metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://muharferdiansyah.my.id

# GA4 Measurement ID, for example G-XXXXXXXXXX.
# Analytics stays disabled until this value is present and valid.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (the content value from the meta tag).
GOOGLE_SITE_VERIFICATION=
